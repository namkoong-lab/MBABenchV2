# Judge secrets — copy this file to judge/.env (gitignored) and fill it in.
# project_configs.sh parses this with grep, NOT `source`: values must be
# plain KEY=VALUE lines, unquoted, one per line. The raw & in the Neon URL
# is fine here (that & is exactly why the file is grep-parsed).

# Neon connection string. Must name the database that matches the preset in
# project_configs.yaml (BizbenchV1 for the v1 preset) — the benchmark
# coherence guard refuses to start on a mismatch.
DATABASE_URL=

# OpenRouter key. The judge always routes its default model
# (google/gemini-2.5-pro) through OpenRouter — see JUDGE_OPENROUTER_MODELS
# in project_configs.sh.
OPENROUTER_API_KEY=

# Optional: only needed if you want S3 uploads (i.e. running WITHOUT
# --no-s3-upload) to use repo-scoped credentials instead of the machine's
# ~/.aws/credentials. Leave empty to use the default AWS credential chain.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
