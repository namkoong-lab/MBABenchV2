# Copy to .env and fill in with your actual keys.
# Usage: cp .env.example .env && vim .env

# ============================================
# API Base URL (optional, auto-detects provider)
# ============================================
# Leave unset for default behavior (OpenRouter if key set, else OpenAI).
# Set to use any OpenAI-compatible server or Anthropic:
#   BASE_URL=http://localhost:8000/v1            # vLLM / SGLang
#   BASE_URL=https://openrouter.ai/api/v1       # OpenRouter
#   BASE_URL=https://api.openai.com/v1           # OpenAI (default)
#   BASE_URL=https://api.anthropic.com           # Anthropic (auto-detected)
# BASE_URL=

# ============================================
# API Keys (at least one required)
# ============================================
# The agent sniffs all three and picks the right one based on BASE_URL.
# For local servers (vLLM/SGLang), no key is needed.
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# AWS S3 (required for auto pipeline)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ============================================
# Database (required for auto pipeline)
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# Langfuse Observability (optional)
# ============================================
# For LLM tracking, cost analytics, and debugging
# Sign up at: https://cloud.langfuse.com (or self-host)
# All three are required to enable Langfuse
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
