# Copy to /etc/judge-annotator.env on the server (mode 600, root-owned).
# The service loads it via systemd EnvironmentFile.

# Neon Postgres — use the restricted `annotator_app` role
# (SELECT on gradings/task_attempts/tasks; SELECT+INSERT on judge_annotations only)
DATABASE_URL=

# AWS key for s3://mbabench (us-east-2): read bundles, write annotations.
# Scope it with a least-privilege IAM policy rather than a broad personal key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Session-cookie signing secret — any long random string
SECRET_KEY=
