# Copy to /etc/judge-annotator.env on the server (mode 600, root-owned).
# The service loads it via systemd EnvironmentFile.

# Neon Postgres — use the restricted `annotator_app` role
# (SELECT on gradings/task_attempts/tasks; SELECT+INSERT on judge_annotations only)
DATABASE_URL=

# The S3 bucket holding the grading bundles and the annotations. Required:
# the code's placeholder default is not a real bucket name.
ANNOTATION_BUCKET=

# The retired bucket older gradings.raw_files_path values still name; their
# bundles were mirrored into ANNOTATION_BUCKET, so this is only used to
# recognise and rewrite those URIs.
LEGACY_BUCKET=

# AWS key for that bucket: read bundles, write annotations.
# Scope it with a least-privilege IAM policy rather than a broad personal key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Session-cookie signing secret — any long random string
SECRET_KEY=
