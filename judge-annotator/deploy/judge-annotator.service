[Unit]
Description=Judge Annotation Site
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/judge-annotator
EnvironmentFile=/etc/judge-annotator.env
ExecStart=/home/ubuntu/judge-annotator/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
[Install]
WantedBy=multi-user.target
